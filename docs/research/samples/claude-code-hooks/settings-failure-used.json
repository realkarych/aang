            "timeout": 10
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /tmp/aang-spike/cc-hooks/bin/rec.py settings",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /tmp/aang-spike/cc-hooks/bin/rec.py settings",
            "timeout": 10
