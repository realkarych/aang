{
  "_launch": "AANG_PROBE_LOG=<log> AANG_RUN=<run> claude -p '<prompt>' --settings <this file> --setting-sources project --plugin-dir <plugin-used dir> --output-format stream-json --verbose --include-hook-events --debug-file <log>",
  "_recorders": {
    "command": "bin/rec.py: reads stdin JSON, appends {recv_ts, env subset, payload} to $AANG_PROBE_LOG",
    "http": "bin/httprec.py 47811: ThreadingHTTPServer, appends {recv_ts, path, headers, payload}, replies 200 with empty body"
  },
  "_skipped_events": [
    "WorktreeCreate",
    "WorktreeRemove"
  ],
