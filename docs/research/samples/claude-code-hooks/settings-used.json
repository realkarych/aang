    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /tmp/aang-spike/cc-hooks/bin/rec.py settings",
            "timeout": 10
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:47811/settings/PreToolUse",
            "timeout": 5,
            "headers": {
              "X-Aang-Run": "$AANG_RUN",
              "X-Aang-Unlisted": "$HOME"
            },
            "allowedEnvVars": [
              "AANG_RUN"
